{
  "name": "dolphin-landing-page-api",
  "version": "1.0.0",
  "description": "Backend API for Dolphin Laundry landing page with admin CMS",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vercel dev",
    "deploy": "vercel",
    "db:generate": "drizzle-kit generate",
    "dev": "bun run src/main.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seeds/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "hono": "^4.6.14",
    "jose": "^5.2.0",
    "postgres": "^3.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vercel/node": "^5.5.16",
    "drizzle-kit": "^0.20.14",
    "vercel": "^50.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
